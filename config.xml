<?xml version="1.0" encoding="utf-8"?>
<widget id="com.nst.iptvsmartersplayer" version="3.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>VLC IPTV</name>
  <description>
        IPTV Smarters Pro is a Live IPTV player for end-users that provides the facility to watch Live TV, VOD, Series.
    </description>
  <author email="aman@newsparktechnology.com" href="https://whmcssmarters.com/">
      IPTV Smarters Pro
    </author>
  <content src="index.html" />
  <plugin name="cordova-plugin-whitelist" spec="1" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <platform name="android">
    <allow-intent href="market:*" />
  </platform>
  <platform name="ios">
    <allow-intent href="itms:*" />
    <allow-intent href="itms-apps:*" />
  </platform>
  <platform name="electron">
    <preference name="ElectronSettingsFilePath" value="platforms/electron/settings.json" />
  </platform>
</widget>